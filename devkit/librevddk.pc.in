#
# pkg-config file of the LibreVDDK developer kit. It finds the kit relative
# to its own place (lib/pkgconfig), so the kit can be unpacked anywhere.
prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: LibreVDDK
Description: VixDiskLib 8 compatible virtual disk library
URL: https://github.com/AltaStor/LibreVDDK
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lvixDiskLib
